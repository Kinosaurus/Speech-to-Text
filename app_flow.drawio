          <mxGeometry as="geometry" x="60" y="100" width="1410" height="85" />
        </mxCell>
        <mxCell id="b1" value="Identify book via RFID/NFC&#10;Load its reviewed local book package" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fff1d6;strokeColor=#b9882d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="230" width="330" height="85" />
        </mxCell>
        <mxCell id="b2" value="Set expected position&#10;Activate current checkpoint + next two in sorted order" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fff1d6;strokeColor=#b9882d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="365" width="330" height="100" />
        </mxCell>
        <mxCell id="b3" value="Capture speech; local streaming ASR&#10;Target: Moonshine instead of WhisperLive" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fff1d6;strokeColor=#b9882d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="520" width="330" height="100" />
        </mxCell>
        <mxCell id="b4" value="Receive partial text and segment/time evidence&#10;Normalize text for matching" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fff1d6;strokeColor=#b9882d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="675" width="330" height="100" />
        </mxCell>
        <mxCell id="b5" value="Use evidence from the current reading progress&#10;Avoid reusing old transcript spans for new triggers" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fff1d6;strokeColor=#b9882d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="830" width="330" height="110" />
        </mxCell>
        <mxCell id="x1" value="Score each active checkpoint with ordered word windows&#10;Apply each phrase coverage and similarity rules" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fff1d6;strokeColor=#b9882d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="230" width="330" height="110" />
