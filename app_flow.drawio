  <diagram id="page-1" name="2 - Current matcher detail">
    <mxGraphModel dx="1500" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Current matcher | Every decision in checkpoint_matcher.py" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="20" width="1420" height="60" />
        </mxCell>
        <mxCell id="t1" value="Receive one transcript callback&#10;If already completed, return without a trigger" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="150" width="330" height="85" />
        </mxCell>
        <mxCell id="t2" value="Select checkpoints[current_index]&#10;Read threshold, stability and min_coverage&#10;Use checkpoint override or manifest default" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="285" width="330" height="105" />
        </mxCell>
        <mxCell id="t3" value="Normalize transcript and checkpoint_text&#10;Unicode NFKC; lowercase; remove punctuation except apostrophes&#10;Collapse whitespace and split into words" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="440" width="330" height="120" />
        </mxCell>
        <mxCell id="t4" value="minimum_words = max(3, ceil(anchor_word_count x min_coverage))&#10;Example: 10-word phrase at 0.8 requires at least 8 words" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="610" width="330" height="110" />
        </mxCell>
        <mxCell id="t5" value="Empty transcript or fewer than minimum_words?" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="770" width="330" height="135" />
        </mxCell>
        <mxCell id="t6" value="Set similarity score = 0" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fdecec;strokeColor=#b65c5c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="970" width="330" height="85" />
        </mxCell>
        <mxCell id="s1" value="Keep only the most recent&#10;max(80, anchor_word_count x 3) transcript words" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="150" width="330" height="100" />
        </mxCell>
        <mxCell id="s2" value="Choose candidate window lengths&#10;From minimum_words through&#10;min(transcript_word_count, anchor_word_count + 2)" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="305" width="330" height="110" />
        </mxCell>
        <mxCell id="s3" value="For each length: slide through every possible start&#10;Keep words in their original reading order" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="465" width="330" height="100" />
        </mxCell>
        <mxCell id="s4" value="Join each candidate window into text&#10;Compare with the full normalized checkpoint phrase" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="615" width="330" height="100" />
        </mxCell>
        <mxCell id="s5" value="Compute RapidFuzz ratio, from 0 to 100&#10;If RapidFuzz is unavailable, use difflib fallback" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="765" width="330" height="100" />
        </mxCell>
        <mxCell id="s6" value="Keep maximum score across all candidate windows" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="915" width="330" height="85" />
        </mxCell>
        <mxCell id="c1" value="Score &gt;= threshold?&#10;Default: 82" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#e8f4ed;strokeColor=#548569;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="150" width="330" height="125" />
        </mxCell>
        <mxCell id="c2" value="Yes: confirmations += 1" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#e8f4ed;strokeColor=#548569;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="325" width="330" height="85" />
        </mxCell>
        <mxCell id="c3" value="No: confirmations = 0" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fdecec;strokeColor=#b65c5c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="1130" width="330" height="85" />
        </mxCell>
        <mxCell id="c4" value="Confirmations &gt;= stability?&#10;Default: 2 callbacks" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#e8f4ed;strokeColor=#548569;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="460" width="330" height="125" />
        </mxCell>
        <mxCell id="c5" value="Yes: take checkpoint.effect&#10;Advance current_index by 1&#10;Reset internal confirmations to 0" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#e8f4ed;strokeColor=#548569;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="650" width="330" height="110" />
