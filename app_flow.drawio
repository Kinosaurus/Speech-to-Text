        <mxCell id="x2" value="Is there a clear candidate match?&#10;Hold if candidate phrases are ambiguous" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fff1d6;strokeColor=#b9882d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="400" width="330" height="140" />
        </mxCell>
        <mxCell id="x3" value="Track confirmations separately for each candidate&#10;Reset a candidate count when its match fails" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fff1d6;strokeColor=#b9882d;strokeWidth=1.5;" vertex="1" parent="1">
