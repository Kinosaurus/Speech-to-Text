          <mxGeometry as="geometry" x="550" y="770" width="330" height="140" />
        </mxCell>
        <mxCell id="x5" value="Confirm chosen checkpoint&#10;Mark earlier unmatched checkpoints skipped&#10;Keep triggered and skipped IDs in session state" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#fff1d6;strokeColor=#b9882d;strokeWidth=1.5;" vertex="1" parent="1">
