        <mxCell id="m5" value="Normalize text; check word count; search ordered word windows&#10;Calculate the best similarity score&#10;Full breakdown on page 2" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;spacing=8;fillColor=#eaf2ff;strokeColor=#5375a5;strokeWidth=1.5;" vertex="1" parent="1">
