        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#566577;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1" source="cache" target="ram">
          <mxGeometry as="geometry" relative="1" />
