          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-9" value="Transcript update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#566577;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1" source="clean" target="active">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="745" y="800" />
