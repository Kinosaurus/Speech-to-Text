        <mxCell id="edge-4" value="Book ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#566577;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1" source="ram" target="read">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="365" y="710" />
