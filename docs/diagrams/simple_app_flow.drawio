          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-12" value="No - keep listening" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#566577;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1" source="confirmed" target="read">
