<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="simple-app-flow" name="Simple intended app flow">
    <mxGraphModel dx="1600" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1350">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Books to Life Pod | Simple intended flow" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1500" height="50" />
        </mxCell>
        <mxCell id="subtitle" value="Proposed design. QR/cloud loading, checking two checkpoints ahead, skipping, and playback are still planned." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="80" width="1500" height="45" />
        </mxCell>
        <mxCell id="head1" value="1. PREPARE THE BOOK" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="350" height="45" />
        </mxCell>
        <mxCell id="head2" value="2. LISTEN TO READING" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="155" width="350" height="45" />
        </mxCell>
        <mxCell id="head3" value="3. FIND THE CHECKPOINT" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="155" width="350" height="45" />
        </mxCell>
        <mxCell id="head4" value="4. PLAY THE EFFECT" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="155" width="350" height="45" />
        </mxCell>
        <mxCell id="scan" value="Parent or child scans book QR code&#10;QR contains the book ID" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e8f0fe;strokeColor=#5376a6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="230" width="280" height="85" />
        </mxCell>
        <mxCell id="cloud" value="Find the selected book package&#10;Use local cache, or download from cloud over Wi-Fi" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e8f0fe;strokeColor=#5376a6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="360" width="280" height="100" />
        </mxCell>
        <mxCell id="cache" value="Save downloaded packages on local storage&#10;Checkpoint JSON plus visual and sound files" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e8f0fe;strokeColor=#5376a6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="510" width="280" height="100" />
        </mxCell>
        <mxCell id="ram" value="Load checkpoint data into RAM&#10;Keep media files on local storage" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e8f0fe;strokeColor=#5376a6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="660" width="280" height="100" />
        </mxCell>
        <mxCell id="read" value="Child or parent reads aloud" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e7f4ec;strokeColor=#58846b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="230" width="280" height="85" />
        </mxCell>
        <mxCell id="mic" value="Microphone captures speech&#10;Audio becomes digital samples" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e7f4ec;strokeColor=#58846b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="360" width="280" height="85" />
        </mxCell>
        <mxCell id="vad" value="Detect speech and ignore silence&#10;Voice activity detection (VAD)" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e7f4ec;strokeColor=#58846b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="490" width="280" height="85" />
        </mxCell>
        <mxCell id="asr" value="Turn speech into text&#10;Speech recognition (ASR)" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e7f4ec;strokeColor=#58846b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="620" width="280" height="85" />
        </mxCell>
        <mxCell id="clean" value="Clean the text for comparison&#10;Lowercase; remove punctuation; tidy spaces" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e7f4ec;strokeColor=#58846b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="750" width="280" height="100" />
        </mxCell>
        <mxCell id="active" value="Choose nearby checkpoints&#10;Current expected checkpoint + next two" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f1eafb;strokeColor=#8662a2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="230" width="280" height="100" />
        </mxCell>
        <mxCell id="score" value="Compare spoken text with checkpoint_text&#10;Fuzzy matching tolerates small reading/recognition errors" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f1eafb;strokeColor=#8662a2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="380" width="280" height="110" />
        </mxCell>
        <mxCell id="confirmed" value="One clear match confirmed?&#10;Enough words, high similarity,&#10;consistent over consecutive updates" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f1eafb;strokeColor=#8662a2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="545" width="280" height="155" />
        </mxCell>
        <mxCell id="progress" value="Record the matched checkpoint_position&#10;Mark earlier missed checkpoints skipped" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f1eafb;strokeColor=#8662a2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="755" width="280" height="110" />
        </mxCell>
        <mxCell id="advance" value="Move to the next checkpoint&#10;Update the three-checkpoint window" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f1eafb;strokeColor=#8662a2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="920" width="280" height="100" />
        </mxCell>
        <mxCell id="complete" value="All checkpoints handled?" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f1eafb;strokeColor=#8662a2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="1075" width="280" height="120" />
        </mxCell>
        <mxCell id="end" value="Checkpoint sequence complete" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f1eafb;strokeColor=#8662a2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="1095" width="280" height="80" />
        </mxCell>
        <mxCell id="effect" value="Read the matched checkpoint's effect object&#10;Do not play missed checkpoints' effects" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#fff0d8;strokeColor=#b58a38;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="230" width="280" height="110" />
        </mxCell>
        <mxCell id="timers" value="Schedule visual and sound independently&#10;visual_delay / sound_delay: milliseconds&#10;from checkpoint confirmation" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#fff0d8;strokeColor=#b58a38;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="400" width="280" height="120" />
        </mxCell>
        <mxCell id="play" value="When each timer is due, start its available asset&#10;visual -&gt; screen/projector&#10;sound -&gt; speakers" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#fff0d8;strokeColor=#b58a38;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="580" width="280" height="130" />
        </mxCell>
        <mxCell id="continue" value="Keep listening while effects run&#10;Timers and playback do not pause reading" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#fff0d8;strokeColor=#b58a38;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="770" width="280" height="100" />
        </mxCell>
        <mxCell id="note" value="The Pi performs speech recognition, checkpoint matching and effect control locally.&#10;Only the selected book is loaded into RAM. New uncached books need Wi-Fi to download.&#10;Current prototype: WhisperLive + one-checkpoint matcher + printed effects. Moonshine is the embedded ASR target." style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#e8f0fe;strokeColor=#5376a6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1090" width="650" height="160" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#566577;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1" source="scan" target="cloud">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#566577;labelBackgroundColor=#ffffff;fontSize=13;" edge="1" parent="1" source="cloud" target="cache">
          <mxGeometry as="geometry" relative="1" />
