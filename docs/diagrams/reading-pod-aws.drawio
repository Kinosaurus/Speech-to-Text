        <mxCell id="library-heading" value="LIBRARY" style="html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#435671;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="130" width="1360" height="24" as="geometry"/></mxCell>
        <mxCell id="aws" value="" style="rounded=1;arcSize=8;fillColor=#F4F8FD;strokeColor=#C9DBF2;connectable=0;" vertex="1" parent="1"><mxGeometry x="62" y="295" width="1416" height="376" as="geometry"/></mxCell>
        <mxCell id="aws-heading" value="AWS · QUEUE AND NOTIFICATIONS" style="html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#2D5481;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="305" width="1360" height="24" as="geometry"/></mxCell>
        <mxCell id="pod" value="" style="rounded=1;arcSize=8;fillColor=#EFF9F6;strokeColor=#B7DDD4;connectable=0;" vertex="1" parent="1"><mxGeometry x="62" y="715" width="1416" height="140" as="geometry"/></mxCell>
        <mxCell id="pod-heading" value="READING POD · CHECK-IN AND SESSION START" style="html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#235B4E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="725" width="1360" height="24" as="geometry"/></mxCell>
        <mxCell id="family" value="&lt;b style=&quot;color:#0F172A;font-size:17px&quot;&gt;Scan the queue QR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#1E293B;font-size:14px&quot;&gt;Parent scans the sign and opens the web page.&lt;br&gt;Enter a mobile number and opt in to turn texts.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="162" width="312" height="83" as="geometry"/></mxCell>
        <mxCell id="staff" value="&lt;b style=&quot;color:#0F172A;font-size:17px&quot;&gt;Staff queue controls&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#1E293B;font-size:14px&quot;&gt;Staff sign in with Cognito.&lt;br&gt;View the queue and handle exceptions.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="455" y="162" width="311" height="83" as="geometry" /></mxCell>
        <mxCell id="text-message" value="&lt;b style=&quot;color:#67430D;font-size:17px&quot;&gt;Receive the turn notification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5E4925;font-size:14px&quot;&gt;The SMS tells the parent where to go.&lt;br&gt;The status page shows their check-in code.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#FFF6E6;strokeColor=#DBB678;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1141" y="162" width="293" height="83" as="geometry"/></mxCell>
        <mxCell id="website" value="&lt;b style=&quot;color:#16427D;font-size:17px&quot;&gt;CloudFront + S3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#284664;font-size:14px&quot;&gt;Serve a mobile queue page from a private bucket.&lt;br&gt;Show ticket status via the API.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="361" width="312" height="104" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b style=&quot;color:#16427D;font-size:17px&quot;&gt;API Gateway + Lambda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#284664;font-size:14px&quot;&gt;Join, check status and check in.&lt;br&gt;On session end, reserve the next turn.&lt;br&gt;An idle pod can accept a new ticket.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="455" y="361" width="311" height="104" as="geometry" /></mxCell>
        <mxCell id="db" value="&lt;b style=&quot;color:#16427D;font-size:17px&quot;&gt;DynamoDB | Queue tickets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#284664;font-size:14px&quot;&gt;Store wait order and active session ID.&lt;br&gt;Complete once and reserve the oldest ticket&lt;br&gt;in one conditional transaction.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#EDF5FF;strokeColor=#93B5EB;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="815" y="361" width="278" height="104" as="geometry" /></mxCell>
        <mxCell id="notify" value="&lt;b style=&quot;color:#16427D;font-size:17px&quot;&gt;DynamoDB Streams + Lambda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#284664;font-size:14px&quot;&gt;React when the next ticket becomes Called.&lt;br&gt;Check that the reservation is still active.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1141" y="361" width="293" height="104" as="geometry" /></mxCell>
        <mxCell id="sms" value="&lt;b style=&quot;color:#67430D;font-size:17px&quot;&gt;AWS End User Messaging SMS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5E4925;font-size:14px&quot;&gt;Send the turn text to the parent.&lt;br&gt;The status page also shows when it is their turn.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#FFF6E6;strokeColor=#DBB678;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1141" y="539" width="293" height="88" as="geometry"/></mxCell>
        <mxCell id="timer" value="&lt;b style=&quot;color:#513790;font-size:17px&quot;&gt;EventBridge Scheduler | Optional&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#4C396A;font-size:14px&quot;&gt;Expire an unclaimed turn after a grace period.&lt;br&gt;Then reserve the next waiting ticket.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#F5F0FF;strokeColor=#BBA5E9;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="539" width="312" height="88" as="geometry" /></mxCell>
        <mxCell id="checkin" value="&lt;b style=&quot;color:#16483E;font-size:17px&quot;&gt;Check in at the pod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#23564B;font-size:14px&quot;&gt;Verify the one-time code.&lt;br&gt;Link the current ticket to the pod session.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#FFFFFF;strokeColor=#86CBBE;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="455" y="755" width="311" height="82" as="geometry" /></mxCell>
        <mxCell id="book" value="&lt;b style=&quot;color:#16483E;font-size:17px&quot;&gt;Scan the book’s QR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#23564B;font-size:14px&quot;&gt;Load the book, start ambience and get ASR ready.&lt;br&gt;Continue with the flow on tab 2.&lt;/span&gt;" style="html=1;rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;fillColor=#FFFFFF;strokeColor=#86CBBE;strokeWidth=1.3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="815" y="755" width="343" height="82" as="geometry"/></mxCell>
