          <mxGeometry x="1100" y="169" width="349" height="90" as="geometry" />
        </mxCell>
        <mxCell id="scan" value="&lt;b style=&quot;font-size:17px;color:#0F172A&quot;&gt;Scan the book’s QR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#1E293B&quot;&gt;The parent or child scans the&lt;br&gt;label added by the librarian.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;overflow=hidden;align=left;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;spacingLeft=14;spacingRight=12;spacingTop=7;spacingBottom=7;" parent="1" vertex="1">
          <mxGeometry x="90" y="398" width="235" height="105" as="geometry" />
        </mxCell>
        <mxCell id="loader" value="&lt;b style=&quot;font-size:17px;color:#513790&quot;&gt;QR launcher · New&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#4C396A&quot;&gt;Resolve the ID and fetch the release.&lt;br&gt;Reuse a verified cached copy when possible.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;overflow=hidden;align=left;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F5F0FF;strokeColor=#BBA5E9;strokeWidth=1.3;spacingLeft=14;spacingRight=12;spacingTop=7;spacingBottom=7;" parent="1" vertex="1">
          <mxGeometry x="384" y="398" width="300" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b style=&quot;font-size:17px;color:#513790&quot;&gt;Local book package&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#4C396A&quot;&gt;Check version and checksums before use.&lt;br&gt;Stage the manifest and referenced assets.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;overflow=hidden;align=left;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F5F0FF;strokeColor=#BBA5E9;strokeWidth=1.3;spacingLeft=14;spacingRight=12;spacingTop=7;spacingBottom=7;" parent="1" vertex="1">
          <mxGeometry x="742" y="398" width="289" height="105" as="geometry" />
        </mxCell>
        <mxCell id="session" value="&lt;b style=&quot;font-size:17px;color:#513790&quot;&gt;Session startup · New&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#4C396A&quot;&gt;Prepare the story in the operator panel.&lt;br&gt;Start opening ambience once playback is ready.&lt;br&gt;Start or reuse ASR in parallel.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;overflow=hidden;align=left;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F5F0FF;strokeColor=#BBA5E9;strokeWidth=1.3;spacingLeft=14;spacingRight=12;spacingTop=7;spacingBottom=7;" parent="1" vertex="1">
