        </mxCell>
        <mxCell id="asr" value="&lt;b style=&quot;font-size:17px;color:#16483E&quot;&gt;Nemotron · 160 ms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#23564B&quot;&gt;The local WSL server streams&lt;br&gt;transcript updates to the client.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;overflow=hidden;align=left;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#86CBBE;strokeWidth=1.3;spacingLeft=14;spacingRight=12;spacingTop=7;spacingBottom=7;" parent="1" vertex="1">
