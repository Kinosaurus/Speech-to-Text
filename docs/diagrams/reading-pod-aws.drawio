        <mxCell id="title" value="Join the Reading Pod queue" style="html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=34;fontColor=#132541;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="62" y="30" width="1416" height="51" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="When the Reading Pod session ends, the next family is automatically sent a text." style="html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#4C627C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="64" y="80" width="1410" height="26" as="geometry" /></mxCell>
