flowchart TD
    A([Start session]) --> B[Select book manifest with CLI]
    B --> C[Validate pages, checkpoint ranges and effect policies]
    C --> D[Microphone or paced recording]
    D --> E[Local ASR produces revised transcript snapshots]
    E --> F[Align recent speech to full book text]
    F --> G{Score, coverage and ambiguity checks pass?}
    G -- No --> D
    G -- Yes --> H{Independent confirmation sufficient?}
    H -- No --> D
    H -- Yes --> I[Update position and advance checkpoint; record skips]
    I --> J{Checkpoint effect policy}
    J -- one_shot --> K{Recent local anchor, endpoint and required words supported?}
    K -- No --> L[Record SUPPRESSED; emit no effect]
    K -- Yes --> M[Emit TRIGGER payload once]
    J -- explicit ambience --> M
    L --> N{Story progress complete?}
    M --> N
    N -- No --> D
    N -- Yes --> O([Progress complete; report emitted, suppressed and skipped separately])
    M -. planned actuator integration .-> P[Preloaded visual, sound and lighting playback]
    Q[RFID book selection - planned] -.-> B

    classDef planned fill:#fff3cd,stroke:#b8860b,color:#222;
    class P,Q planned;
