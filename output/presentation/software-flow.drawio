<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram name="Software flow" id="software-flow"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1920" pageHeight="1080"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="book" value="&lt;b&gt;Selected book JSON&lt;/b&gt;&lt;br/&gt;Full passage + checkpoint word positions&lt;br/&gt;Anchor phrases + reusable effect payloads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#E9F5F4;strokeColor=#B9CAD5;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="1330" y="210" width="520" height="150" as="geometry" /></mxCell><mxCell id="hints" value="&lt;b&gt;Moving book hints&lt;/b&gt;&lt;br/&gt;Short nearby passage prompt&lt;br/&gt;Next checkpoint + 2 ahead&lt;br/&gt;Soft bias, not proof of speech" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#E9F5F4;strokeColor=#B9CAD5;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="900" y="210" width="350" height="150" as="geometry" /></mxCell><mxCell id="audio" value="&lt;b&gt;1. Audio input&lt;/b&gt;&lt;br/&gt;Mic or recording&lt;br/&gt;Child or parent" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#B9CAD5;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="230" height="150" as="geometry" /></mxCell><mxCell id="client" value="&lt;b&gt;2. Stream audio&lt;/b&gt;&lt;br/&gt;16 kHz mono PCM&lt;br/&gt;Local WebSocket&lt;br/&gt;port 9090" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#B9CAD5;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="350" y="490" width="240" height="150" as="geometry" /></mxCell><mxCell id="vad" value="&lt;b&gt;3. Detect speech&lt;/b&gt;&lt;br/&gt;VAD filters silence&lt;br/&gt;Read continuously&lt;br/&gt;across checkpoints" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#EFF5FA;strokeColor=#B9CAD5;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="230" height="150" as="geometry" /></mxCell><mxCell id="asr" value="&lt;b&gt;4. Speech to text&lt;/b&gt;&lt;br/&gt;faster-whisper&lt;br/&gt;NVIDIA GPU / CUDA&lt;br/&gt;Partial + final text" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#EFF5FA;strokeColor=#B9CAD5;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="940" y="490" width="260" height="150" as="geometry" /></mxCell><mxCell id="align" value="&lt;b&gt;5. Align words&lt;/b&gt;&lt;br/&gt;Recent transcript&lt;br/&gt;vs full book passage&lt;br/&gt;Word-order matching" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#B9CAD5;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="1280" y="490" width="270" height="150" as="geometry" /></mxCell><mxCell id="guard" value="&lt;b&gt;6. Confirm&lt;/b&gt;&lt;br/&gt;Similarity + coverage&lt;br/&gt;Consecutive updates&lt;br/&gt;Skip missed scenes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#B9CAD5;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="1610" y="490" width="240" height="150" as="geometry" /></mxCell><mxCell id="output" value="&lt;b&gt;7. Emit payload&lt;/b&gt;&lt;br/&gt;[TRIGGER] + JSON&lt;br/&gt;Once per checkpoint&lt;br/&gt;Printed in prototype" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#B9CAD5;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="1610" y="820" width="240" height="150" as="geometry" /></mxCell><mxCell id="effects" value="&lt;b&gt;Planned: effect controller&lt;/b&gt;&lt;br/&gt;Fades, timing, sound ducking&lt;br/&gt;Lights / sound / projector&lt;br/&gt;Spacing policy to implement" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#B9CAD5;fontColor=#16324A;dashed=1;" vertex="1" parent="1"><mxGeometry x="1180" y="820" width="340" height="150" as="geometry" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526A7D;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="audio" target="client"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="audio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526A7D;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="client" target="vad"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526A7D;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="vad" target="asr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="transcript" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526A7D;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="asr" target="align"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526A7D;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="align" target="guard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="book context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#007E87;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;" edge="1" parent="1" source="book" target="hints"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-6" value="book reference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#007E87;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=0.16346153846153846;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="book" target="align"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="prompt + hotwords" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#007E87;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=0.4857142857142857;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="hints" target="asr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="confirmed progress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#007E87;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.4;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="guard" target="hints"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1890" y="550" /><mxPoint x="1890" y="182" /><mxPoint x="1075" y="182" /></Array></mxGeometry></mxCell><mxCell id="edge-9" value="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526A7D;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="guard" target="output"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="planned" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526A7D;fontColor=#526A7D;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;dashed=1;" edge="1" parent="1" source="output" target="effects"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="diagram-title" value="&lt;b&gt;Books to Life Pod: software flow&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=46;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="60" y="44" width="1600" height="70" as="geometry" /></mxCell><mxCell id="diagram-subtitle" value="Working PC prototype | Jetson deployment is the next hardware validation step" style="text;html=1;whiteSpace=wrap;align=left;fontSize=25;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="60" y="114" width="1600" height="40" as="geometry" /></mxCell><mxCell id="weak-match" value="Weak / ambiguous match:&lt;br/&gt;No trigger; keep listening" style="text;html=1;whiteSpace=wrap;align=left;fontSize=22;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="1280" y="690" width="350" height="70" as="geometry" /></mxCell><mxCell id="current-status" value="&lt;b&gt;Implemented:&lt;/b&gt; PC GPU, passage tracking, live book hints.&lt;br/&gt;&lt;b&gt;To validate:&lt;/b&gt; child-reading accuracy, response delay, Jetson." style="text;html=1;whiteSpace=wrap;align=left;fontSize=24;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="60" y="834" width="1000" height="110" as="geometry" /></mxCell><mxCell id="deployment" value="PC: native Python client + Docker GPU server. No physical playback yet." style="text;html=1;whiteSpace=wrap;align=left;fontSize=22;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="60" y="943" width="1000" height="45" as="geometry" /></mxCell><mxCell id="legend" value="Solid = implemented path. Dashed = planned physical effects. | 11 October 2026" style="text;html=1;whiteSpace=wrap;align=left;fontSize=22;fontColor=#16324A;" vertex="1" parent="1"><mxGeometry x="60" y="1025" width="1700" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>