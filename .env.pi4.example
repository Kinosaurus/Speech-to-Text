# Copy to .env on the Pi. Indexes below must come from the container's device list.
ASR_MODEL=base.en
ASR_THREADS=2
BOOK_MANIFEST=sample_story.json
INPUT_DEVICE=default
AUDIO_CHUNK=1024
# Use: getent group audio | cut -d: -f3
AUDIO_GID=29
# Change to 1 only after prepare_models.py has cached the selected model and VAD.
HF_HUB_OFFLINE=0
